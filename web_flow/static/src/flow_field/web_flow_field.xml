<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_flow.Field">
        <div class="o_web_flow" t-ref="this.rootRef"
             t-att-class="{ 'o_web_flow_fullscreen': this.state.fullscreen, 'o_web_flow_readonly': this.isReadonly }">
            <div class="o_web_flow_canvas" t-ref="this.canvasRef" t-att-style="this.canvasStyle"
                 t-att-class="{ 'o_web_flow_panning': this.state.panning }"
                 t-on-pointerdown="this.onCanvasPointerDown" t-on-wheel="this.onWheel">
                <t t-set="layout" t-value="this.layout"/>
                <div class="o_web_flow_world" t-att-style="this.worldStyle">
                    <svg class="o_web_flow_edges" xmlns="http://www.w3.org/2000/svg" width="1" height="1">
                        <path t-foreach="layout.edges" t-as="edge" t-key="edge.key" t-att-d="edge.path"
                              t-att-class="'o_web_flow_edge o_web_flow_edge_' + edge.branch"/>
                        <path t-foreach="layout.gotos" t-as="goto" t-key="goto.key" t-att-d="goto.path"
                              class="o_web_flow_edge o_web_flow_edge_goto" marker-end="url(#o_web_flow_arrow)"/>
                        <defs>
                            <marker id="o_web_flow_arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" class="o_web_flow_arrow"/>
                            </marker>
                        </defs>
                    </svg>

                    <t t-foreach="layout.edges" t-as="edge" t-key="edge.key">
                        <span t-if="edge.label" class="o_web_flow_branch_label"
                              t-att-class="'o_web_flow_branch_' + edge.branch"
                              t-attf-style="left: {{ edge.labelAt.x }}px; top: {{ edge.labelAt.y }}px;" t-out="edge.label"/>
                        <Dropdown t-if="!this.isReadonly" menuClass="'o_web_flow_add_menu'" position="'bottom-start'">
                            <button type="button" class="o_web_flow_add_btn o-dropdown--no-caret"
                                    t-att-class="{ 'o_web_flow_add_insert': edge.before }"
                                    t-att-title="edge.before ? 'Insert a step here' : 'Add a step'"
                                    t-att-data-edge="edge.key"
                                    t-attf-style="left: {{ edge.plus.x }}px; top: {{ edge.plus.y }}px;"
                                    t-on-pointerdown="(ev) => ev.stopPropagation()"><i class="oi" data-icon="add"/></button>
                            <t t-set-slot="content">
                                <div t-foreach="this.typeGroups" t-as="group" t-key="group.label"
                                     t-att-class="'o_web_flow_add_group o_web_flow_color_' + group.color">
                                    <div t-if="group.label" class="dropdown-header" t-out="group.label"/>
                                    <DropdownItem t-foreach="group.types" t-as="type" t-key="type.type"
                                                  attrs="{ title: type.help }" onSelected="() => this.pick(type, edge)">
                                        <i class="oi pe-1" t-att-data-icon="type.icon"/><t t-out="type.label"/>
                                    </DropdownItem>
                                </div>
                            </t>
                        </Dropdown>
                    </t>

                    <div t-foreach="layout.ends" t-as="end" t-key="end.key" class="o_web_flow_end"
                         t-att-class="{ 'o_web_flow_movable': end.movable and !this.isReadonly, 'o_web_flow_dragged': this.state.drag and this.state.drag.id === end.key }"
                         t-attf-style="left: {{ end.x }}px; top: {{ end.y }}px; width: {{ this.END_W }}px; height: {{ this.END_H }}px;"
                         t-on-pointerdown="(ev) => this.onCardPointerDown(ev, end, 'end')">END</div>

                    <div t-foreach="layout.pills" t-as="pill" t-key="pill.id" class="o_web_flow_end o_web_flow_pill"
                         t-att-class="(pill.status ? 'o_web_flow_status_' + pill.status : '') + (this.state.drag and this.state.drag.id === pill.id ? ' o_web_flow_dragged' : '')"
                         t-att-data-node-id="pill.id" t-att-title="pill.name"
                         t-attf-style="left: {{ pill.x }}px; top: {{ pill.y }}px; width: {{ this.END_W }}px; height: {{ this.END_H }}px;"
                         t-on-pointerdown="(ev) => this.onCardPointerDown(ev, pill)">
                        END
                        <button t-if="!this.isReadonly" type="button" class="o_web_flow_pill_delete" title="Delete"
                                t-on-click.stop="() => this.deleteStep(pill)"><i class="oi" data-icon="close_small"/></button>
                    </div>

                    <div t-foreach="layout.cards" t-as="card" t-key="card.id" class="o_web_flow_card"
                         t-att-class="(card.kind === 'start' ? 'o_web_flow_start' : 'o_web_flow_type_' + card.type + ' o_web_flow_color_' + (card.color or 0))
                                      + (card.warning ? ' o_web_flow_warning' : '')
                                      + (card.status ? ' o_web_flow_status_' + card.status : '')
                                      + (this.state.drag and this.state.drag.id === card.id ? ' o_web_flow_dragged' : '')"
                         t-att-data-node-id="card.kind === 'start' ? false : card.id"
                         t-attf-style="left: {{ card.x }}px; top: {{ card.y }}px; width: {{ this.CARD_W }}px; height: {{ this.CARD_H }}px;"
                         t-on-pointerdown="(ev) => this.onCardPointerDown(ev, card, card.kind === 'start' ? 'start' : 'node')">
                        <span class="o_web_flow_icon"><i class="oi" t-att-data-icon="card.icon"/></span>
                        <div class="o_web_flow_card_body">
                            <div t-if="card.type_label" class="o_web_flow_card_type" t-out="card.type_label"/>
                            <div class="o_web_flow_card_name" t-att-title="card.name" t-out="card.name"/>
                            <div t-if="card.warning" class="o_web_flow_card_warning" t-att-title="card.warning">
                                <i class="oi" data-icon="warning"/> <t t-out="card.warning"/>
                            </div>
                            <div t-elif="card.summary" class="o_web_flow_card_summary" t-att-title="card.summary" t-out="card.summary"/>
                        </div>
                        <div t-if="!this.isReadonly and card.kind !== 'start'" class="o_web_flow_card_menu">
                            <Dropdown menuClass="'o_web_flow_add_menu'" position="'bottom-end'">
                                <button type="button" class="btn btn-link btn-sm p-0 o-dropdown--no-caret" title="Actions">
                                    <i class="oi" data-icon="more_vert"/>
                                </button>
                                <t t-set-slot="content">
                                    <DropdownItem onSelected="() => this.openStep(card)">
                                        <i class="oi pe-1" data-icon="edit"/>Edit
                                    </DropdownItem>
                                    <div t-foreach="this.optionalBranches(card)" t-as="branch" t-key="branch.key">
                                        <div class="dropdown-header" t-out="branch.label"/>
                                        <DropdownItem t-foreach="this.state.data.types" t-as="type" t-key="type.type"
                                                      onSelected="() => this.addStep({ type, parent: card, branch })">
                                            <i class="oi pe-1" t-att-data-icon="type.icon"/><t t-out="type.label"/>
                                        </DropdownItem>
                                    </div>
                                    <div class="dropdown-divider"/>
                                    <DropdownItem class="'text-danger'" onSelected="() => this.deleteStep(card)">
                                        <i class="oi pe-1" data-icon="delete"/>Delete
                                    </DropdownItem>
                                </t>
                            </Dropdown>
                        </div>
                    </div>
                </div>

                <div t-if="layout.cards.length + layout.pills.length === 1 and !this.isReadonly" class="o_web_flow_hint text-muted small">
                    <t t-if="!this.props.record.resId">Save the record, then add the first step with the + button.</t>
                    <t t-else="">Add the first step with the + button.</t>
                </div>

                <div class="o_web_flow_toolbar">
                    <div class="btn-group">
                        <button type="button" class="btn btn-light" title="Zoom out" t-on-click="() => this.zoom(-0.1)"><i class="oi" data-icon="remove"/></button>
                        <button type="button" class="btn btn-light o_web_flow_zoom" title="Actual size" t-on-click="() => this.zoom(0)"><t t-out="Math.round(this.state.scale * 100)"/>%</button>
                        <button type="button" class="btn btn-light" title="Zoom in" t-on-click="() => this.zoom(0.1)"><i class="oi" data-icon="add"/></button>
                        <button type="button" class="btn btn-light" title="Fit to view" t-on-click="() => this.fit()"><i class="oi" data-icon="recenter"/></button>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-light o_web_flow_fullscreen_btn"
                                t-att-title="this.state.fullscreen ? 'Exit full screen (Esc)' : 'Full screen'"
                                t-on-click="() => this.toggleFullscreen()">
                            <i class="oi" t-att-data-icon="this.state.fullscreen ? 'fullscreen_exit' : 'fullscreen'"/>
                        </button>
                        <button t-if="!this.isReadonly and this.props.record.resId" type="button" class="btn btn-light"
                                title="Place every card again (forget the positions set by hand)"
                                t-on-click="() => this.resetLayout()"><i class="oi" data-icon="account_tree"/></button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
